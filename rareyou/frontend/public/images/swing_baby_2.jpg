<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 750" width="600" height="750">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FAF8F5" />
      <stop offset="50%" stop-color="#F3EEEA" />
      <stop offset="100%" stop-color="#EBE4DC" />
    </linearGradient>
    <radialGradient id="haloGrad" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#7C6853" stop-opacity="0.12" />
      <stop offset="100%" stop-color="#7C6853" stop-opacity="0" />
    </radialGradient>
  </defs>

  <rect width="600" height="750" fill="url(#bgGrad)"/>
  <rect width="600" height="750" fill="url(#haloGrad)"/>

  <rect x="20" y="20" width="560" height="710" fill="none" stroke="#E5DFD7" stroke-width="1.5" rx="4"/>
  <rect x="28" y="28" width="544" height="694" fill="none" stroke="#F5EFE6" stroke-width="1" rx="2"/>

  <text x="300" y="65" font-family="'Montserrat', sans-serif" font-size="11" font-weight="600" letter-spacing="4" fill="#8C827A" text-anchor="middle">RARE YOU • STUDIO FARIDABAD</text>
  <line x1="230" y1="80" x2="370" y2="80" stroke="#C47D68" stroke-width="1.5" stroke-linecap="round"/>

  <g transform="translate(0, 30)">
    
      <line x1="220" y1="100" x2="260" y2="280" stroke="#7C6853" stroke-width="4" stroke-dasharray="6,4"/>
      <line x1="380" y1="100" x2="340" y2="280" stroke="#7C6853" stroke-width="4" stroke-dasharray="6,4"/>
      <ellipse cx="300" cy="300" rx="90" ry="35" fill="none" stroke="#7C6853" stroke-width="5"/>
      <path d="M210,300 C210,380 390,380 390,300" fill="none" stroke="#7C6853" stroke-width="4"/>
      <line x1="240" y1="350" x2="240" y2="410" stroke="#4A5844" stroke-width="3"/>
      <line x1="300" y1="360" x2="300" y2="420" stroke="#4A5844" stroke-width="3"/>
      <line x1="360" y1="350" x2="360" y2="410" stroke="#4A5844" stroke-width="3"/>
    
  </g>

  <rect x="45" y="540" width="510" height="155" fill="#FFFFFF" fill-opacity="0.9" rx="8" stroke="#EDE7DF" stroke-width="1"/>
  
  <text x="300" y="580" font-family="'Montserrat', sans-serif" font-size="12" font-weight="700" letter-spacing="3" fill="#4A5844" text-anchor="middle">SWINGS</text>
  
  <text x="300" y="615" font-family="'Montserrat', serif" font-size="20" font-weight="600" fill="#23211E" text-anchor="middle">Baby Swing Off-White</text>
  
  <text x="300" y="645" font-family="'Montserrat', sans-serif" font-size="12" font-weight="400" fill="#6E6862" text-anchor="middle">Artisanal Studio Detail</text>

  <g transform="translate(300, 672)">
    <circle cx="-40" cy="0" r="3" fill="#C47D68"/>
