# =================================================================
# INFYSHOPY MARKETPLACE STUDIO — ENVIRONMENT CONFIGURATION
# =================================================================

# -----------------------------------------------------------------
# 1. CORE SERVER & SESSION CONFIGURATION
# -----------------------------------------------------------------
PORT=5000
FRONTEND_PORT=3000
NODE_ENV=development
SESSION_SECRET=infyshopy_secure_session_secret_key_2026_dev

# -----------------------------------------------------------------
# 2. CLOUDINARY CDN (Crucial for Marketplace Image Hosting)
# Marketplaces (Meesho, Flipkart, Amazon) require public image URLs
# in Excel sheets. Get these from https://console.cloudinary.com/
# -----------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------
# 3. MEESHO SUPPLIER PANEL API
# Direct inventory updates & order retrieval from Meesho.
# Obtain from Meesho Supplier Panel -> Developer / Settings
# Note: For catalog listing, Meesho uses the compiled .xlsx flat file.
# -----------------------------------------------------------------
MEESHO_API_BASE_URL=https://supplier.meesho.com/api/v1
MEESHO_SUPPLIER_ID=your_meesho_supplier_id
MEESHO_API_KEY=your_meesho_api_key
MEESHO_SECRET_KEY=your_meesho_secret_key

# -----------------------------------------------------------------
# 4. FLIPKART MARKETPLACE SELLER API (SP-API / v3)
# Allows automated listing sync, price updates & inventory feeds.
# Register app at https://api.flipkart.net/
# -----------------------------------------------------------------
FLIPKART_API_BASE_URL=https://api.flipkart.net/sellers
FLIPKART_APP_ID=your_flipkart_app_id
FLIPKART_APP_SECRET=your_flipkart_app_secret
FLIPKART_SELLER_ID=your_flipkart_seller_id

# -----------------------------------------------------------------
# 5. AMAZON INDIA SELLING PARTNER API (SP-API)
# Official Amazon Seller Central API for feeds & listing operations.
# Marketplace ID for India (amazon.in): A21TJRUUN4KGV
# SP-API Endpoint for India/EU: https://sellingpartnerapi-eu.amazon.com
# -----------------------------------------------------------------
AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV
AMAZON_SELLER_ID=your_merchant_seller_token
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
AMAZON_LWA_CLIENT_ID=amzn1.application-oa2-client.your_client_id
AMAZON_LWA_CLIENT_SECRET=your_lwa_client_secret
AMAZON_SP_API_REFRESH_TOKEN=your_sp_api_refresh_token
AMAZON_AWS_ACCESS_KEY_ID=your_aws_iam_access_key
AMAZON_AWS_SECRET_ACCESS_KEY=your_aws_iam_secret_key
AMAZON_AWS_REGION=eu-west-1

# -----------------------------------------------------------------
# 6. MYNTRA PARTNER PORTAL API
# For Myntra Partner Fashion catalog & inventory integration.
# -----------------------------------------------------------------
MYNTRA_API_BASE_URL=https://pp-api.myntra.com
MYNTRA_PARTNER_API_KEY=your_myntra_partner_key
MYNTRA_STORE_ID=your_myntra_store_id

# -----------------------------------------------------------------
# 7. SNAPDEAL SELLER CONNECT API
# For Snapdeal Apparel Feed integration.
# -----------------------------------------------------------------
SNAPDEAL_API_KEY=your_snapdeal_api_key
SNAPDEAL_SELLER_TOKEN=your_snapdeal_seller_token

# -----------------------------------------------------------------
# 8. AMAZON SMARTBIZ D2C STOREFRONT
# -----------------------------------------------------------------
SMARTBIZ_STORE_ID=your_smartbiz_store_id
SMARTBIZ_ACCESS_TOKEN=your_smartbiz_access_token
